---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    q: "What is an Enrolled Agent?",
    a: "An Enrolled Agent (EA) is a federally authorized tax practitioner who has earned the privilege of representing taxpayers before the IRS in all 50 states. EAs are licensed by the federal government, not individual states."
  },
  {
    q: "What types of IRS issues can you help with?",
    a: "We handle audits, unfiled returns, tax debt, Offers in Compromise, installment agreements, penalty abatement, interest abatement, liens, levies, wage garnishments, and other IRS collection actions."
  },
  {
    q: "Do I need to be in San Francisco to work with you?",
    a: "No. As an Enrolled Agent, Nitasha is authorized to represent taxpayers before the IRS nationwide. We work with clients across all 50 states via secure virtual consultations."
  },
  {
    q: "What should I bring to an initial consultation?",
    a: "Any IRS correspondence you have received, your most recent tax returns (if available), and a brief summary of your situation. We will provide a specific document checklist after our initial conversation."
  },
  {
    q: "How much do your services cost?",
    a: "Fees depend on the complexity of your situation. After an initial consultation, we provide a clear engagement letter outlining scope, timeline, and fees before any work begins."
  },
  {
    q: "Can you help with cryptocurrency taxes?",
    a: "Yes. Nitasha has specialized experience in crypto tax reporting from her tenure as a Senior Crypto Tax Analyst at CoinTracker. We can help with cost basis calculations, DeFi transactions, wallet reconciliation, and IRS compliance."
  }
];
---

<Base title="FAQ" description="Frequently asked questions about Apex Tax Solutions, IRS representation, Enrolled Agents, and our services.">
  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <h1 class="mb-12">Frequently Asked Questions</h1>

      <div class="space-y-8">
        {faqs.map((faq) => (
          <div class="border-b border-[var(--color-muted)]/20 pb-8">
            <h3 class="text-xl mb-3">{faq.q}</h3>
            <p class="font-sans text-muted">{faq.a}</p>
          </div>
        ))}
      </div>

      <p class="mt-12 text-xs text-muted font-sans italic">
        This content is for general informational purposes only and does not constitute tax, legal, or accounting advice. Consult a qualified professional regarding your specific situation.
      </p>

      <div class="mt-12">
        <a href="/contact" class="btn-primary">Still Have Questions? Get in Touch</a>
      </div>
    </div>
  </section>
</Base>
