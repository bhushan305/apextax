---
import Base from '../layouts/Base.astro';
import { GOOGLE_SCRIPT_URL } from '../config.js';
---

<Base title="Contact" description="Get in touch with Apex Tax Solutions. Submit an inquiry for tax preparation, representation, or advisory services.">
  <section class="section-padding">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h1 class="mb-4">Start Here: Request Your Intro Call</h1>
        <p class="text-muted font-sans mb-8">Provide a few details about your tax situation and we'll schedule an introductory call.</p>

        <div class="mt-12">
          <h3 class="text-lg mb-3">Get in Touch</h3>
          <p class="font-sans text-muted mb-2">(415) 503-9056</p>
          <p class="font-sans text-muted mb-2">info@goapextax.com</p>
          <p class="font-sans text-muted">San Francisco, CA</p>
        </div>
      </div>
      <form id="contact-form" name="contact" method="POST" data-netlify="true" class="flex flex-col gap-4">
        <input type="hidden" name="form-name" value="contact" />
        <input type="text" name="first_name" placeholder="First Name" required class="form-input" />
        <input type="text" name="last_name" placeholder="Last Name" required class="form-input" />
        <input type="email" name="email" placeholder="Email" required class="form-input" />
        <textarea name="message" placeholder="Message" required class="form-input"></textarea>
        <button type="submit" class="btn-primary self-start mt-2">Send</button>
        <p id="contact-form-status" class="font-sans text-sm hidden"></p>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ GOOGLE_SCRIPT_URL }}>
  document.getElementById("contact-form").addEventListener("submit", async function(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const status = document.getElementById("contact-form-status");
    const original = btn.textContent;

    btn.disabled = true;
    btn.textContent = "Sending…";
    status.classList.add("hidden");

    const payload = {
      first_name: form.first_name.value,
      last_name:  form.last_name.value,
      email:      form.email.value,
      message:    form.message.value,
      page:       "contact",
      source:     "website – contact page"
    };

    try {
      // Send to Google Sheets
      await fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      // Also submit to Netlify Forms as backup
      const netlifyData = new FormData(form);
      await fetch("/", { method: "POST", body: netlifyData }).catch(() => {});

      form.reset();
      status.textContent = "Thank you! We'll be in touch soon.";
      status.className = "font-sans text-sm text-green-700";
    } catch (err) {
      status.textContent = "Something went wrong. Please call us or try again.";
      status.className = "font-sans text-sm text-red-600";
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });
</script>
