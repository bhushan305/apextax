---
import Base from '../../layouts/Base.astro';
---

<Base title="Tax Advisory" description="Tax controversy resolution, tax strategy, and cryptocurrency tax reporting. Strategic guidance from a former IRS tax professional.">
  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <h1 class="mb-6">Tax Advisory</h1>
      <p class="text-lg text-muted font-sans mb-8">Tax controversy resolution and tax strategy — including specialized cryptocurrency tax reporting.</p>

      <div class="prose font-sans">
        <h3 class="mt-12 mb-4">Tax Controversy Resolution</h3>
        <p class="mb-4">When you're facing a dispute with the IRS, the right strategy can mean the difference between a devastating outcome and a manageable resolution. We analyze your situation, identify the strongest legal positions, and develop a resolution strategy informed by years of IRS experience.</p>

        <h3 class="mt-12 mb-4">Tax Strategy</h3>
        <p class="mb-4">Proactive tax planning to minimize your tax burden within the bounds of the law. We help you structure transactions, time income and deductions, and make informed decisions about your tax position.</p>

        <h3 class="mt-12 mb-4">Cryptocurrency Tax</h3>
        <p class="mb-4">Specialized guidance on crypto asset reporting — from cost basis calculation and wallet reconciliation to DeFi transactions and NFT sales. Informed by Nitasha's tenure as a Senior Crypto Tax Analyst at CoinTracker.</p>
      </div>

      <div class="mt-12">
        <a href="/contact" class="btn-primary">Get Strategic Guidance</a>
      </div>
    </div>
  </section>
</Base>
