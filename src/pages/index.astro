---
import Base from '../layouts/Base.astro';
import { GOOGLE_SCRIPT_URL } from '../config.js';
---

<Base title="Home">
  <!-- Hero Section -->
  <section class="relative w-full h-[85vh] min-h-[600px] flex items-start overflow-hidden">
  <img
    src="https://images.unsplash.com/photo-1589405858862-2ac9cbb41321?auto=format&fit=crop&w=1920&q=80"
    alt="Snow-covered Saile mountain in Austria during daytime"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 w-full px-6 md:px-12 lg:pr-16 pt-8 md:pt-12">
      <div class="md:ml-auto md:w-7/12 lg:w-1/2 text-white">
        <h1 class="text-4xl md:text-6xl leading-tight mb-6 whitespace-nowrap">Rise Above Tax<br/>Uncertainty</h1>
        <p class="text-lg md:text-xl font-sans opacity-90 mb-8">Former IRS tax pro on your side.</p>
        <a href="/contact" class="btn-primary bg-white! text-[var(--color-navy)]! border-white!">Get Started</a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section-padding max-w-6xl mx-auto">
    <h2 class="text-center mb-16">Services</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Tax Preparation -->
      <a href="/services/tax-preparation" class="group block">
        <div class="aspect-square overflow-hidden rounded-sm mb-6">
          <img
            src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=600&q=80"
            alt="Financial documents on a warm-toned desk"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <h3 class="text-xl mb-2">Tax Preparation</h3>
        <p class="text-muted font-sans text-sm">File with confidence.</p>
      </a>

      <!-- Tax Representation -->
      <a href="/services/tax-representation" class="group block">
        <div class="aspect-square overflow-hidden rounded-sm mb-6">
          <img
            src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=600&q=80"
            alt="Legal documents and professional workspace"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <h3 class="text-xl mb-2">Tax Representation</h3>
        <p class="text-muted font-sans text-sm">Get a former IRS tax professional to represent you.</p>
      </a>

      <!-- Tax Advisory -->
      <a href="/services/tax-advisory" class="group block">
        <div class="aspect-square overflow-hidden rounded-sm mb-6">
          <img
            src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=600&q=80"
            alt="Strategic planning with charts and analysis"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <h3 class="text-xl mb-2">Tax Advisory</h3>
        <p class="text-muted font-sans text-sm">Plan ahead with expert tax guidance.</p>
      </a>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="section-padding bg-[var(--color-navy)]/5">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col items-center">
        <div class="w-72 h-72 md:w-80 md:h-80 rounded-full overflow-hidden">
          <img
            src="/images/Nitasha Image.jpeg"
            alt="Nitasha Ahuja, EA — Founder of Apex Tax Solutions"
            class="w-full h-full object-cover object-top"
            loading="lazy"
          />
        </div>
        <p class="font-serif text-lg mt-4 text-center">Nitasha Ahuja, Enrolled Agent (EA)</p>
      </div>
      <div>
        <h2 class="mb-6">Former IRS Tax Pro<br/>on Your Side</h2>
        <p class="text-muted font-sans mb-8">With 15+ years at the IRS and an MSL in Taxation from Georgetown Law, Nitasha brings an inside perspective and practical guidance to help you navigate complex tax matters.</p>
        <a href="/about" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Inquiry Form -->
  <section class="section-padding">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h2 class="mb-4">Start Here: Request Your Intro Call</h2>
        <p class="text-muted font-sans">Provide a few details about your tax situation and we'll schedule an introductory call.</p>
      </div>
      <form id="home-form" name="contact" method="POST" data-netlify="true" class="flex flex-col gap-4">
        <input type="hidden" name="form-name" value="contact" />
        <input type="text" name="first_name" placeholder="First Name" required class="form-input" />
        <input type="text" name="last_name" placeholder="Last Name" required class="form-input" />
        <input type="email" name="email" placeholder="Email" required class="form-input" />
        <textarea name="message" placeholder="Message" required class="form-input"></textarea>
        <button type="submit" class="btn-primary self-start mt-2">Send</button>
        <p id="home-form-status" class="font-sans text-sm hidden"></p>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ GOOGLE_SCRIPT_URL }}>
  document.getElementById("home-form").addEventListener("submit", async function(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const status = document.getElementById("home-form-status");
    const original = btn.textContent;

    btn.disabled = true;
    btn.textContent = "Sending…";
    status.classList.add("hidden");

    const payload = {
      first_name: form.first_name.value,
      last_name:  form.last_name.value,
      email:      form.email.value,
      message:    form.message.value,
      page:       "home",
      source:     "website – home page"
    };

    try {
      await fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const netlifyData = new FormData(form);
      await fetch("/", { method: "POST", body: netlifyData }).catch(() => {});

      form.reset();
      status.textContent = "Thank you! We'll be in touch soon.";
      status.className = "font-sans text-sm text-green-700";
    } catch (err) {
      status.textContent = "Something went wrong. Please call us or try again.";
      status.className = "font-sans text-sm text-red-600";
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });
</script>
